# Copy to .env and edit. Never commit .env.

# Database password (any long random string): openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Optional: enables the /v1/admin HTTP API. At least 32 characters.
# openssl rand -base64 32
KITCOUNT_ADMIN_TOKEN=

# Image tag to run (a release such as 1.0.0, or latest)
KITCOUNT_VERSION=latest

# Host port for plain HTTP (when not using the https profile)
KITCOUNT_PORT=8080

# For `docker compose --profile https up -d`
KITCOUNT_DOMAIN=sync.example.org
KITCOUNT_TRUST_PROXY=true
