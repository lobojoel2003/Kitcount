{
  "name": "kitcount",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jest-expo": "~58.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "templates": "node scripts/bundle-templates.mjs",
    "templates:check": "node scripts/bundle-templates.mjs --check",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "jest --ci --config jest.e2e.config.js",
    "export:web": "expo export --platform web",
    "prebuild": "expo prebuild --clean",
    "screenshots": "node scripts/screenshots.mjs",
    "test:web": "node scripts/screenshots.mjs --out dist-smoke --no-hero"
  },
  "private": true,
  "description": "Kitcount — offline-first, privacy-first data app for syringe services programs.",
  "license": "GPL-3.0-or-later",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@noble|yaml|react-native-qrcode-svg|react-native-svg))",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/core/e2e/"
    ],
    "collectCoverageFrom": [
      "src/core/**/*.ts",
      "!src/core/reports/bundled-templates.ts",
      "!src/core/**/__tests__/**",
      "!src/core/e2e/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "branches": 75,
        "functions": 85,
        "statements": 85
      }
    },
    "testMatch": [
      "**/?(*.)+(test).[jt]s?(x)"
    ]
  }
}
